{
  "project": "bsp-notify",
  "site": "primary",
  "libraries": {
    "scripts": { "root": "code", "path": "apps/bsp-notify" },
    "pnp2": { "root": "lib", "path": "pnp2.bundle.js" }
  },
  "lists": {
    "notifications": {
      "title": "Notifications",
      "columns": [
        { "name": "Body", "type": "Note" },
        { "name": "To", "type": "Note" },
        { "name": "From", "type": "Text" },
        { "name": "CC", "type": "Note" },
        { "name": "BCC", "type": "Note" },
        { "name": "NotifyStatus", "type": "Choice", "choices": ["Queued", "Sending", "Sent", "Failed"] },
        { "name": "StatusTime", "type": "DateTime" },
        { "name": "Attempts", "type": "Number" },
        { "name": "Source", "type": "Text" },
        { "name": "NotifyType", "type": "Text" },
        { "name": "RunId", "type": "Text" },
        { "name": "Detail", "type": "Note" }
      ]
    },
    "testRuns": {
      "title": "TestRuns",
      "columns": [
        { "name": "Suite", "type": "Text" },
        { "name": "Passed", "type": "Boolean" },
        { "name": "Results", "type": "Note" },
        { "name": "GitSha", "type": "Text" }
      ]
    }
  },
  "pages": {
    "template": { "path": "_app-template.aspx" },
    "harness": { "path": "_harness-bsp-notify.aspx" }
  },
  "flows": ["BSP Notify"],
  "deploy": { "mode": "copy" }
}
